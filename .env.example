APP_NAME=Prospect
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Outreach sending guardrails. Sending is refused outside production unless
# OUTREACH_ALLOW_SEND is true, and never exceeds the daily limit.
OUTREACH_ALLOW_SEND=false
OUTREACH_DAILY_SEND_LIMIT=20

# Outreach IMAP: the account letters are sent from. Enables appending sent mail
# to its Sent folder, and is the first mailbox outreach:poll reads. Leave
# OUTREACH_IMAP_HOST empty to disable both.
OUTREACH_IMAP_HOST=
OUTREACH_IMAP_PORT=993
OUTREACH_IMAP_ENCRYPTION=ssl
OUTREACH_IMAP_USERNAME=
OUTREACH_IMAP_PASSWORD=

# Further mailboxes outreach:poll also reads, for replies to outreach sent from
# another address (a batch sent by hand before this app existed, say). Polling
# only. Slots _2_ and _3_ are available; leave the host empty to skip one.
OUTREACH_IMAP_2_HOST=
OUTREACH_IMAP_2_PORT=993
OUTREACH_IMAP_2_ENCRYPTION=ssl
OUTREACH_IMAP_2_USERNAME=
OUTREACH_IMAP_2_PASSWORD=

# Thijssensoftware ID (SSO + portal switcher). Client id/secret are issued when
# prospect is registered as an OAuth client in the ID app. Provisioning is off:
# only an existing local user (matched by email) may sign in via SSO.
THIJSSENSOFTWARE_ID_URL=https://id.thijssensoftware.nl
THIJSSENSOFTWARE_ID_CLIENT_ID=
THIJSSENSOFTWARE_ID_CLIENT_SECRET=
THIJSSENSOFTWARE_ID_APP_SLUG=prospect
THIJSSENSOFTWARE_ID_PROVISION=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
